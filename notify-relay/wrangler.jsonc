{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aries-notify",
  "account_id": "d47990d8be8da7136b8f22f8ab360194",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "notify.aries.shiroel.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aries-notify",
      "database_id": "4fa5c576-d2e6-4c73-9006-76505724bf36",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  // Registration is public; Expo's optional server credential is typed separately.
  "secrets": { "required": [] },
}
