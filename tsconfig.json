{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "artifacts",
    "build",
    "scripts",
    "**/node_modules",
    "**/target",
    "**/.cloudflare",
    "feedback-worker",
    "notify-relay",
    "__tests__/feedbackWorker*.test.ts",
    "__tests__/notifyRelay*.test.ts",
    "**/Pods",
    "launch-videos"
  ]
}
